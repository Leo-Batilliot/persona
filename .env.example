# =====================================================================
#  Copie ce fichier en ".env" :  cp .env.example .env
#  Puis remplace les valeurs. NE COMMIT JAMAIS le .env réel.
# =====================================================================

# --- PostgreSQL ---
POSTGRES_USER=persona_admin
POSTGRES_PASSWORD=change_me_strong_password_123!

# --- n8n : clé de chiffrement des credentials ---
#  Génère-la avec :  openssl rand -hex 32
#  Si tu la perds, tous tes credentials n8n deviennent illisibles.
N8N_ENCRYPTION_KEY=remplace_par_une_cle_de_64_caracteres_hex
