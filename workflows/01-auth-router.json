    },
    {
      "id": "11111111-0001-4000-8000-000000000018",
      "name": "Create Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1820, 340],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sessions (session_id, user_id, pseudo, role) VALUES ($1, $2::uuid, $3, $4) ON CONFLICT (session_id) DO UPDATE SET user_id = EXCLUDED.user_id, pseudo = EXCLUDED.pseudo, role = EXCLUDED.role, expires_at = now() + INTERVAL '24 hours'",
        "options": {
          "queryReplacement": "={{ $('Parse Input').first().json.sessionId }},={{ $json.user_id }},={{ $json.pseudo }},={{ $json.role }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "persona-db"
        }
      }
    },
