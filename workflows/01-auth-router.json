{
  "name": "01 — Auth & Router",
  "nodes": [
    {
      "id": "aa000001-0001-4000-8000-000000000001",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "webhookId": "22222222-0001-4000-8000-000000000001",
      "parameters": {"options": {}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000002",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst chatInput = (item.json.chatInput || '')\n  .replace(/[\\x00-\\x08\\x0B-\\x0C\\x0E-\\x1F]/g, '')\n  .trim()\n  .substring(0, 500);\nconst sessionId = (item.json.sessionId || '').trim();\nconst loginMatch = chatInput.match(/^(?:login|connexion)\\s+(\\S+)\\s+(.+)$/i);\nconst isRegisterIntent = /^(?:register|inscription|cr[eé]er?\\s+(?:un\\s+)?compte)/i.test(chatInput);\nreturn [{\n  json: {\n    chatInput,\n    sessionId,\n    isLoginAttempt: loginMatch !== null,\n    loginPseudo: loginMatch ? loginMatch[1] : null,\n    loginPassword: loginMatch ? loginMatch[2].trim() : null,\n    isRegisterIntent\n  }\n}];"
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000003",
      "name": "Check Pending Reg",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [520, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT step FROM pending_registrations WHERE session_id = $1 AND expires_at > now() LIMIT 1",
        "options": {
          "alwaysOutputData": true,
          "queryReplacement": "={{ $json.sessionId }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000004",
      "name": "Pending Reg?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, 300],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.step }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000005",
      "name": "Set Register Intent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1040, 160],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {"id": "x1", "name": "intent", "value": "register", "type": "string"},
            {"id": "x2", "name": "chatInput", "value": "={{ $('Parse Input').first().json.chatInput }}", "type": "string"},
            {"id": "x3", "name": "sessionId", "value": "={{ $('Parse Input').first().json.sessionId }}", "type": "string"},
            {"id": "x4", "name": "user_id", "value": "", "type": "string"},
            {"id": "x5", "name": "pseudo", "value": "", "type": "string"},
            {"id": "x6", "name": "role", "value": "user", "type": "string"}
          ]
        },
        "includeOther": false
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000006",
      "name": "Continue Registration",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1300, 160],
      "parameters": {
        "source": "database",
        "workflowId": {
          "value": "0",
          "__rl": true,
          "mode": "id"
        },
        "options": {"waitForSubWorkflow": true}
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000007",
      "name": "Get Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1040, 440],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT user_id::text, pseudo, role FROM sessions WHERE session_id = $1 AND expires_at > now() LIMIT 1",
        "options": {
          "alwaysOutputData": true,
          "queryReplacement": "={{ $('Parse Input').first().json.sessionId }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000008",
      "name": "Session Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1300, 440],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.user_id }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000009",
      "name": "Prepare Ollama Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sessionData = $input.first().json;\nconst chatInput = $('Parse Input').first().json.chatInput;\nconst safeInput = chatInput.replace(/[\"\\\\]/g, (c) => ({ '\"': \"'\", '\\\\': '' })[c]).substring(0, 200);\nconst prompt = `Classify this user message into exactly one category.\\n\\nCategories:\\n- register : user wants to create an account or sign up\\n- update_prefs : user wants to change email, interests, newsletter time\\n- newsletter : user wants to receive their newsletter now or asks about it\\n- unsubscribe : user wants to unsubscribe or delete account\\n- status : user wants to see their profile, current preferences, or account information\\n- help : user asks what they can do or asks for help\\n- unknown : none of the above\\n\\nMessage: \"${safeInput}\"\\n\\nReply with ONLY the category name, nothing else.`;\nreturn [{\n  json: {\n    user_id: sessionData.user_id,\n    pseudo: sessionData.pseudo,\n    role: sessionData.role,\n    chatInput,\n    sessionId: $('Parse Input').first().json.sessionId,\n    ollamaPrompt: prompt\n  }\n}];"
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000010",
      "name": "Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1820, 240],
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'llama3.2:3b', prompt: $json.ollamaPrompt, stream: false }) }}"
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000011",
      "name": "Parse Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2080, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ollamaResp = $input.first().json;\nconst prev = $('Prepare Ollama Prompt').first().json;\nconst rawResponse = (ollamaResp.response || '').trim().toLowerCase();\nconst KNOWN = ['register','update_prefs','newsletter','unsubscribe','status','help'];\nconst intent = KNOWN.find(k => rawResponse.startsWith(k)) || 'unknown';\nreturn [{\n  json: {\n    user_id: prev.user_id,\n    pseudo: prev.pseudo,\n    role: prev.role,\n    chatInput: prev.chatInput,\n    sessionId: prev.sessionId,\n    intent,\n    rawOllamaResponse: rawResponse\n  }\n}];"
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000012",
      "name": "Route Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [2340, 240],
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {"outputKey": "0", "conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [{"id": "r1", "leftValue": "={{ $json.intent }}", "rightValue": "register", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
            {"outputKey": "1", "conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [{"id": "r2", "leftValue": "={{ $json.intent }}", "rightValue": "update_prefs", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
            {"outputKey": "2", "conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [{"id": "r3", "leftValue": "={{ $json.intent }}", "rightValue": "newsletter", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
            {"outputKey": "3", "conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [{"id": "r4", "leftValue": "={{ $json.intent }}", "rightValue": "unsubscribe", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
            {"outputKey": "4", "conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [{"id": "r5", "leftValue": "={{ $json.intent }}", "rightValue": "help", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}},
            {"outputKey": "5", "conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [{"id": "r6", "leftValue": "={{ $json.intent }}", "rightValue": "status", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}}
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000013",
      "name": "WF2: Register",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [2600, 0],
      "parameters": {
        "source": "database",
        "workflowId": {"value": "0", "__rl": true, "mode": "id"},
        "options": {"waitForSubWorkflow": true}
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000014",
