      "typeVersion": 1.1,
      "position": [2600, 140],
      "parameters": {
        "source": "database",
        "workflowId": {"value": "0", "__rl": true, "mode": "id"},
        "options": {"waitForSubWorkflow": true}
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000015",
      "name": "WF3: Newsletter",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [2600, 280],
      "parameters": {
        "source": "database",
        "workflowId": {"value": "0", "__rl": true, "mode": "id"},
        "options": {"waitForSubWorkflow": true}
      }
    },
