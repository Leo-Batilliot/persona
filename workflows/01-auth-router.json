      "typeVersion": 1.1,
      "position": [2600, 420],
      "parameters": {
        "source": "database",
        "workflowId": {"value": "0", "__rl": true, "mode": "id"},
        "options": {"waitForSubWorkflow": true}
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000017",
      "name": "Help",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2600, 560],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [{"id": "a1", "name": "output", "value": "=Bonjour {{ $json.pseudo }} ! Voici ce que vous pouvez faire :\n\n• newsletter — recevoir votre newsletter maintenant\n• mes préférences — voir votre profil et vos réglages\n• modifier préférences — changer email, centres d'intérêt ou horaire\n• register / inscription — créer un compte (si pas encore fait)\n• désinscription — se désinscrire de Persona", "type": "string"}]
        },
        "includeOther": false
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000018",
      "name": "Unknown Intent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2600, 700],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [{"id": "a2", "name": "output", "value": "=Je n'ai pas bien compris votre demande, {{ $json.pseudo }}.\n\nEssayez : newsletter, préférences, désinscription, ou aide.", "type": "string"}]
        },
        "includeOther": false
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000019",
      "name": "Login Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1560, 640],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id": "c2", "leftValue": "={{ $('Parse Input').first().json.isLoginAttempt }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000020",
      "name": "Authenticate User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1820, 560],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id::text AS user_id, pseudo, role FROM users WHERE pseudo = $1 AND password_hash = crypt($2, password_hash) AND is_active = true LIMIT 1",
        "options": {
          "alwaysOutputData": true,
          "queryReplacement": "={{ $('Parse Input').first().json.loginPseudo }},={{ $('Parse Input').first().json.loginPassword }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000021",
      "name": "Auth Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2080, 560],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id": "c3", "leftValue": "={{ $json.user_id }}", "rightValue": "", "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}}
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000022",
      "name": "Create Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2340, 460],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sessions (session_id, user_id, pseudo, role) VALUES ($1, $2::uuid, $3, $4) ON CONFLICT (session_id) DO UPDATE SET user_id = EXCLUDED.user_id, pseudo = EXCLUDED.pseudo, role = EXCLUDED.role, expires_at = now() + INTERVAL '24 hours'",
        "options": {
          "queryReplacement": "={{ $('Parse Input').first().json.sessionId }},={{ $json.user_id }},={{ $json.pseudo }},={{ $json.role }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000023",
      "name": "Audit: Login Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2600, 460],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_log (user_id, action, detail) VALUES ($1::uuid, 'login_success', '{}'::jsonb)",
        "options": {
          "queryReplacement": "={{ $('Authenticate User').first().json.user_id }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000024",
      "name": "Welcome",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2860, 460],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [{"id": "a3", "name": "output", "value": "=Bienvenue {{ $('Authenticate User').first().json.pseudo }} ! Vous êtes connecté(e).\n\nCommandes : newsletter · préférences · désinscription · aide", "type": "string"}]
        },
        "includeOther": false
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000025",
      "name": "Audit: Login Fail",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2340, 660],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_log (user_id, action, detail) VALUES (NULL, 'login_fail', jsonb_build_object('pseudo', $1))",
        "options": {
          "queryReplacement": "={{ $('Parse Input').first().json.loginPseudo }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000026",
      "name": "Wrong Credentials",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2600, 660],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [{"id": "a4", "name": "output", "value": "Identifiants incorrects.\n\nFormat : login <pseudo> <mot_de_passe>", "type": "string"}]
        },
        "includeOther": false
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000027",
      "name": "Please Login",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1820, 760],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [{"id": "a5", "name": "output", "value": "Bonjour ! Je suis Persona, votre agrégateur de newsletters IA.\n\n• Connexion : login <pseudo> <mot_de_passe>\n• Créer un compte : tapez register", "type": "string"}]
        },
        "includeOther": false
      }
    },
    {
      "id": "aa000001-0001-4000-8000-000000000028",
      "name": "Get User Profile",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2600, 840],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pseudo, email, interests, send_hour, created_at::date::text AS since FROM users WHERE id = $1::uuid AND is_active = true LIMIT 1",
        "options": {
          "alwaysOutputData": true,
          "queryReplacement": "={{ $json.user_id }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
      "id": "aa000001-0001-4000-8000-000000000029",
      "name": "Profile Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 840],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const user = $input.first().json;\nif (!user.pseudo) {\n  return [{ json: { output: 'Impossible de récupérer votre profil. Essayez de vous reconnecter.' } }];\n}\nconst interests = Array.isArray(user.interests) && user.interests.length > 0\n  ? user.interests.join(', ')\n  : 'tous (aucun filtre)';\nconst hour = user.send_hour !== null && user.send_hour !== undefined\n  ? user.send_hour + 'h00'\n  : 'non défini';\nreturn [{\n  json: {\n    output: 'Votre profil Persona :\\n\\n• Pseudo : ' + user.pseudo + '\\n• Email : ' + (user.email || 'non défini') + '\\n• Intérêts : ' + interests + '\\n• Newsletter à : ' + hour + '\\n• Membre depuis : ' + (user.since || '?') + '\\n\\nPour modifier, tapez : modifier préférences'\n  }\n}];"
      }
    }
  ],
