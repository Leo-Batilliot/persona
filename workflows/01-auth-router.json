{
  "name": "01 — Auth & Router",
  "nodes": [
    {
      "id": "11111111-0001-4000-8000-000000000001",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "webhookId": "22222222-0001-4000-8000-000000000001",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000002",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\n\n// Sanitize: strip control chars that could pollute prompts or SQL\nconst chatInput = (item.json.chatInput || '')\n  .replace(/[\\x00-\\x08\\x0B-\\x0C\\x0E-\\x1F]/g, '')\n  .trim()\n  .substring(0, 500);\n\nconst sessionId = (item.json.sessionId || '').trim();\n\n// Detect login command: \"login <pseudo> <password>\"\nconst loginMatch = chatInput.match(\n  /^(?:login|connexion)\\s+(\\S+)\\s+(.+)$/i\n);\n\n// Early detection of register intent (for unauthenticated users)\nconst isRegisterIntent = /^(?:register|inscription|cr[eé]er?\\s+(?:un\\s+)?compte)/i.test(chatInput);\n\nreturn [{\n  json: {\n    chatInput,\n    sessionId,\n    isLoginAttempt: loginMatch !== null,\n    loginPseudo: loginMatch ? loginMatch[1] : null,\n    loginPassword: loginMatch ? loginMatch[2].trim() : null,\n    isRegisterIntent\n  }\n}];"
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000003",
      "name": "Get Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [520, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT user_id::text, pseudo, role FROM sessions WHERE session_id = $1 AND expires_at > now() LIMIT 1",
        "options": {
          "alwaysOutputData": true,
          "queryReplacement": "={{ $json.sessionId }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "persona-db"
        }
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000004",
      "name": "Session Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.user_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000005",
      "name": "Prepare Ollama Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 80],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sessionData = $input.first().json;\nconst chatInput = $('Parse Input').first().json.chatInput;\n\n// Anti-prompt-injection: wrap user message in a neutral container\n// and strip any quote chars that could escape the wrapper\nconst safeInput = chatInput\n  .replace(/[\"\\\\]/g, (c) => ({ '\"': \"'\", '\\\\': '' })[c])\n  .substring(0, 200);\n\nconst prompt = `Classify this user message into exactly one category.\n\nCategories:\n- register : user wants to create an account or sign up\n- update_prefs : user wants to change email, interests, newsletter time\n- newsletter : user wants to receive their newsletter now or asks about it\n- unsubscribe : user wants to unsubscribe or delete account\n- help : user asks what they can do or asks for help\n- unknown : none of the above\n\nMessage: \"${safeInput}\"\n\nReply with ONLY the category name, nothing else.`;\n\nreturn [{\n  json: {\n    user_id: sessionData.user_id,\n    pseudo: sessionData.pseudo,\n    role: sessionData.role,\n    chatInput,\n    sessionId: $('Parse Input').first().json.sessionId,\n    ollamaPrompt: prompt\n  }\n}];"
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000006",
      "name": "Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 80],
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'llama3.2:3b', prompt: $json.ollamaPrompt, stream: false }) }}"
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000007",
      "name": "Parse Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 80],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ollamaResp = $input.first().json;\nconst prev = $('Prepare Ollama Prompt').first().json;\n\n// Ollama returns { response: \"register\", done: true, ... }\nconst rawResponse = (ollamaResp.response || '').trim().toLowerCase();\n\n// Normalize to known intents — guards against Ollama adding punctuation\nconst KNOWN = ['register', 'update_prefs', 'newsletter', 'unsubscribe', 'help'];\nconst intent = KNOWN.find(k => rawResponse.startsWith(k)) || 'unknown';\n\nreturn [{\n  json: {\n    user_id: prev.user_id,\n    pseudo: prev.pseudo,\n    role: prev.role,\n    chatInput: prev.chatInput,\n    sessionId: prev.sessionId,\n    intent,\n    rawOllamaResponse: rawResponse\n  }\n}];"
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000008",
      "name": "Route Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1820, 80],
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "outputKey": "0",
              "conditions": {
                "options": {"caseSensitive": false, "typeValidation": "loose"},
                "conditions": [{"id": "r1", "leftValue": "={{ $json.intent }}", "rightValue": "register", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              }
            },
            {
              "outputKey": "1",
              "conditions": {
                "options": {"caseSensitive": false, "typeValidation": "loose"},
                "conditions": [{"id": "r2", "leftValue": "={{ $json.intent }}", "rightValue": "update_prefs", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              }
            },
            {
              "outputKey": "2",
              "conditions": {
                "options": {"caseSensitive": false, "typeValidation": "loose"},
                "conditions": [{"id": "r3", "leftValue": "={{ $json.intent }}", "rightValue": "newsletter", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              }
            },
            {
              "outputKey": "3",
              "conditions": {
                "options": {"caseSensitive": false, "typeValidation": "loose"},
                "conditions": [{"id": "r4", "leftValue": "={{ $json.intent }}", "rightValue": "unsubscribe", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              }
            },
            {
              "outputKey": "4",
              "conditions": {
                "options": {"caseSensitive": false, "typeValidation": "loose"},
                "conditions": [{"id": "r5", "leftValue": "={{ $json.intent }}", "rightValue": "help", "operator": {"type": "string", "operation": "equals"}}],
                "combinator": "and"
              }
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "id": "11111111-0001-4000-8000-000000000009",
