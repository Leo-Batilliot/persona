      "position": [1300, 60],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_log (user_id, action, detail) VALUES ($1::uuid, 'unsubscribe', jsonb_build_object('email', $2))",
        "options": {
          "queryReplacement": "={{ $('Find User').first().json.id }},={{ $('Find User').first().json.email }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
