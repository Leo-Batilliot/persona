      "position": [780, 160],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "cc000004-0004-4000-8000-000000000005",
      "name": "Set Inactive",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1040, 60],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE users SET is_active = false WHERE unsubscribe_token = $1::uuid AND is_active = true",
        "options": {
          "queryReplacement": "={{ $('Webhook').first().json.query.token }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
