      "name": "Valid Token?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [260, 300],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "loose"},
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query.token }}",
              "rightValue": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "operator": {"type": "string", "operation": "regex"}
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "cc000004-0004-4000-8000-000000000003",
      "name": "Find User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [520, 160],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id::text, email, pseudo FROM users WHERE unsubscribe_token = $1::uuid AND is_active = true UNION ALL SELECT NULL, NULL, NULL LIMIT 1",
        "options": {
          "queryReplacement": "={{ $('Webhook').first().json.query.token }}"
        }
      },
      "credentials": {"postgres": {"id": "1", "name": "persona-db"}}
    },
    {
